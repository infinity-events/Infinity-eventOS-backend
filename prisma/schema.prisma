// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Festival {
  id String @id @default(uuid())

  name String

  location String

  startDate DateTime

  endDate DateTime

  tickets Ticket[]

  wristbands Wristband[]

  entranceLogs EntranceLog[]

  transactions Transaction[]

  status FestivalStatus @default(BOZZA)

  reportEmail String?

  ownerId String?

  owner User? @relation("OwnedFestivals", fields: [ownerId], references: [id])

  ticketCategories TicketCategory[]

  stripeAccountId String? @unique
  stripeAccountStatus String?
}

enum FestivalStatus {
  BOZZA
  ATTIVO
  CHIUSO
}

model Ticket {
  id String @id @default(uuid())

  code String @unique

  type TicketType

  price Float

  status TicketStatus @default(GENERATED)

  createdAt DateTime @default(now())

  festivalId String

  festival Festival @relation(fields: [festivalId], references: [id])

  categoryId String?

  category TicketCategory? @relation(fields: [categoryId], references: [id])

  userId String?

  user User? @relation(fields: [userId], references: [id])

  wristband Wristband?

  entranceLogs EntranceLog[]

  paymentStatus PaymentStatus @default(PAID)
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TicketType {
  STANDARD

  VIP

  BACKSTAGE
}

enum TicketStatus {
  GENERATED

  ACTIVATED

  CANCELLED
}

model TicketCategory {
  id String @id @default(uuid())

  name String

  type TicketType

  price Float

  quantity Int

  sold Int @default(0)

  festivalId String

  festival Festival @relation(fields: [festivalId], references: [id])

  tickets Ticket[]

  createdAt DateTime @default(now())
}

model Wristband {
  id String @id @default(uuid())

  uid String? @unique

  code String @unique

  activationCode String @unique

  activated Boolean @default(false)

  createdAt DateTime @default(now())

  festivalId String?

  festival Festival? @relation(fields: [festivalId], references: [id])

  ticketId String? @unique

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  userId String?

  user User? @relation(fields: [userId], references: [id])

  transactions Transaction[]

  entranceLogs EntranceLog[]
}

enum WristbandStatus {
  CREATED

  SHIPPED

  ACTIVATED

  BLOCKED
}

model User {
  id String @id @default(uuid())

  firebaseUid String @unique

  email String @unique

  firstName String

  lastName String

  phone       String?

  birthDate   String?

  address     String?

  city        String?

  province    String?

  zipCode     String?
  
  country     String?

  role Role @default(CUSTOMER)

  createdAt DateTime @default(now())

  tickets Ticket[]

  wristbands Wristband[]

  wallet Wallet?

  operatorTransactions Transaction[] @relation("OperatorTransactions")

  ownedFestivals Festival[] @relation("OwnedFestivals")

  operatorEntranceLogs EntranceLog[] @relation("OperatorEntrance")

  entranceLogs EntranceLog[] @relation("ParticipantEntrance")
}

model EntranceLog {
  id String @id @default(uuid())

  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  wristbandId String?
  wristband   Wristband? @relation(fields: [wristbandId], references: [id])

  userId String?
  user   User?   @relation("ParticipantEntrance", fields: [userId], references: [id])

  operatorId String?
  operator   User?   @relation("OperatorEntrance", fields: [operatorId], references: [id])

  method EntranceMethod

  action EntranceAction

  gate String?

  device String?

  createdAt DateTime @default(now())
}

enum EntranceAction {
  ENTRY
  EXIT
}

enum EntranceMethod {
  QR
  NFC
  MANUAL
}

enum Role {
  CUSTOMER

  STAFF

  SECURITY

  CASHIER

  ADMIN

  OWNER
}

model Wallet {
  id String @id @default(uuid())

  balance Float @default(0)

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Float
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id])

  wristbandId String?
  wristband   Wristband? @relation(fields: [wristbandId], references: [id])

  operatorId String?
  operator   User?   @relation("OperatorTransactions", fields: [operatorId], references: [id])
}

enum TransactionType {
  TOPUP
  PURCHASE
  REFUND
  TRANSFER
}
